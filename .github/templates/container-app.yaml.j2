properties:
  template:
    containers:
      - name: {{ container_app_name }}
        image: {{ registry_name }}.azurecr.io/{{ image_name }}:{{ image_tag }}
        resources:
          cpu: 0.5
          memory: 1.0Gi
        env:
          - name: NODE_ENV
            value: production
          - name: PORT
            value: "3000"
        probes:
          - type: Liveness
            httpGet:
              path: /health
              port: 3000
              scheme: HTTP
            initialDelaySeconds: 5
            periodSeconds: 10
          - type: Readiness
            httpGet:
              path: /health
              port: 3000
              scheme: HTTP
            initialDelaySeconds: 5
            periodSeconds: 10
    scale:
      minReplicas: 1
      maxReplicas: 3
      rules:
        - name: http-scaler
          http:
            metadata:
              concurrentRequests: "50"
